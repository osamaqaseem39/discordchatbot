# Discord Bot Configuration
BOT_PREFIX=!
BOT_MAX_RESPONSE_LENGTH=1000
BOT_EMBED_COLOR=0x4CAF50
BOT_ERROR_COLOR=0xff6b6b
BOT_WARNING_COLOR=0xffa726
BOT_INFO_COLOR=0x2196F3
OPENAI_API_KEY=
DISCORD_TOKEN=

# OpenAI Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.3
OPENAI_SYSTEM_PROMPT="You are an expert Amazon FBA (Fulfillment by Amazon) business advisor and cashflow strategist. You help entrepreneurs build profitable Amazon businesses through: - Product research and selection strategies - Profit margin analysis and calculations - Inventory management and cashflow optimization - Market analysis and competitor research - PPC advertising strategies - Supplier sourcing and negotiation - Amazon SEO and listing optimization - Risk management and diversification - Scaling strategies for established sellers Always provide actionable, specific advice with real numbers and examples when possible. Focus on sustainable, ethical business practices and long-term cashflow generation. Keep responses educational and professional, suitable for both beginners and experienced sellers."

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=5
RATE_LIMIT_REQUESTS_PER_HOUR=25
RATE_LIMIT_PREMIUM_REQUESTS_PER_MINUTE=10
RATE_LIMIT_PREMIUM_REQUESTS_PER_HOUR=50

# Cache Configuration
CACHE_ENABLED=True
CACHE_TTL_HOURS=2
CACHE_MAX_ENTRIES=1000

# Channel Configuration
CHANNEL_RESTRICTED_MODE=True
CHANNEL_ALLOWED_CHANNELS=
CHANNEL_CONVERSATION_MODE=True
CHANNEL_RESPONSE_TO_MENTIONS=True